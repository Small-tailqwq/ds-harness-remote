{
  "name": "dsh-lango",
  "version": "0.1.0",
  "description": "Pair a phone with DeepSeek Harness over a private network (LAN, WireGuard, Tailscale, ZeroTier) with no server or account.",
  "keywords": ["deepseek", "deepseek-harness", "dsh", "dsh-plugin", "lan", "remote"],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "lango": "./bin/lango.js"
  },
  "files": ["bin", "dist/index.js", "dsh-plugin.json", "cordis.patch.yml", "README.md", "LICENSE", "LICENSE.ds-harness-remote"],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=24.9"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@lukeburns/clatterjs": "1.0.0",
    "@noble/ciphers": "^1.1.3",
    "@noble/curves": "^1.7.0",
    "@noble/hashes": "^1.6.1",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.25.0",
    "qrcode": "^1.5.4",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "ws": "^8.21.3",
    "zod": "^4.6.7"
  }
}
